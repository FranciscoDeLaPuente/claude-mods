#!/bin/sh
# Ningún commit en main, y la rama se llama tipo/descripcion (ver CLAUDE.md).

# HEAD separado (rebase, bisect…): no hay rama que comprobar
branch=$(git symbolic-ref --quiet --short HEAD) || exit 0
# Cierre de un merge con conflictos: los merges a main están permitidos
git rev-parse --quiet --verify MERGE_HEAD >/dev/null && exit 0

exec sh "$(dirname "$0")/rules.sh" branch "$branch"
